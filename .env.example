# Salin menjadi .env untuk pengembangan lokal. Di hosting, isi sebagai Environment Variables.
# JANGAN commit file .env yang berisi nilai asli.

# ---- Integrasi SIMPATI 555 (login & data pengurus) ----
SIMPATI_API_URL=https://alamat-simpati-555-anda
# Harus SAMA PERSIS dengan SIMPATI_INTEGRATION_TOKEN di SIMPATI 555 dan server Survey GPS
SIMPATI_INTEGRATION_TOKEN=ganti-dengan-token-acak-panjang

# ---- Integrasi Survey GPS (hasil verifikasi). Kosongkan bila belum dipakai ----
SURVEY_API_URL=https://alamat-server-survey-gps-anda

# ---- Sesi ----
# Wajib diisi acak minimal 32 karakter, mis: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# true di hosting (HTTPS). false hanya untuk uji lokal lewat http://localhost
COOKIE_SECURE=true
SESSION_HOURS=8
# Batas penyusunan proposal AI per akun per jam
GENERATE_PER_HOUR=20

# ---- Gemini ----
AI_API_KEY=
# Opsional, urut prioritas. Bawaan: gemini-3.8-flash,gemini-3.5-flash
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash
